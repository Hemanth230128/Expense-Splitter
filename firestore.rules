rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * SPLITWISEPRO SECURITY RULES
     * 
     * Core Philosophy:
     * This ruleset implements an "Authorization Independence" model. To ensure high performance and 
     * avoid costly cross-document lookups (get() calls), group membership and roles are denormalized 
     * (copied) directly onto every document within a group's hierarchy.
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isMember(membersMap) {
      return isSignedIn() && membersMap != null && membersMap[request.auth.uid] != null;
    }

    function isAdmin(membersMap) {
      return isSignedIn() && membersMap != null && (membersMap[request.auth.uid] == 'admin');
    }

    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    function isExistingMember(membersMap) {
      return resource != null && isMember(membersMap);
    }

    function isSelfExitGroupUpdate() {
      return isSignedIn() &&
             resource != null &&
             isMember(resource.data.members) &&
             request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['members.' + request.auth.uid, 'updatedAt']) &&
             request.resource.data.members[request.auth.uid] == null;
    }

    // --- Collection Rules ---

    /**
     * @description Rules for individual user profiles.
     * @path /users/{userId}
     * @allow Authenticated users can read (get/list) to allow searching by email.
     */
    match /users/{userId} {
      // Allow searching and viewing profiles so users can invite each other by email
      allow read: if isSignedIn();
      // Only the user themselves can create or modify their profile
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for collaborative expense groups.
     * @path /groups/{groupId}
     */
    match /groups/{groupId} {
      allow get: if isSignedIn() && (resource == null || isMember(resource.data.members));
      allow list: if isSignedIn(); 
      allow create: if isSignedIn() && request.resource.data.creatorId == request.auth.uid;
      allow update: if (isExistingMember(resource.data.members) && isAdmin(resource.data.members)) || isSelfExitGroupUpdate();
      allow delete: if isExistingMember(resource.data.members) && isAdmin(resource.data.members);

      match /members/{memberUserId} {
        allow get: if isMember(resource.data.groupMembers);
        allow list: if isSignedIn();
        allow create: if isSignedIn() && isAdmin(request.resource.data.groupMembers);
        allow update: if isExistingMember(resource.data.groupMembers) && isAdmin(resource.data.groupMembers);
        allow delete: if (isExistingMember(resource.data.groupMembers) && isAdmin(resource.data.groupMembers)) ||
                      (isExistingMember(resource.data.groupMembers) && memberUserId == request.auth.uid);
      }

      match /expenses/{expenseId} {
        allow get: if isMember(resource.data.groupMembers);
        allow list: if isSignedIn();
        allow create: if isSignedIn() && isMember(request.resource.data.groupMembers) && request.resource.data.groupId == groupId;
        allow update: if isExistingMember(resource.data.groupMembers);
        allow delete: if isExistingMember(resource.data.groupMembers);

        match /shares/{userId} {
          allow get: if isMember(resource.data.groupMembers);
          allow list: if isSignedIn();
          allow create: if isSignedIn() && isMember(request.resource.data.groupMembers) && request.resource.data.userId == userId;
          allow update: if isExistingMember(resource.data.groupMembers) && request.resource.data.userId == resource.data.userId;
          allow delete: if isExistingMember(resource.data.groupMembers);
        }
      }

      match /settlements/{settlementId} {
        allow get: if isMember(resource.data.groupMembers);
        allow list: if isSignedIn();
        allow create: if isSignedIn() && isMember(request.resource.data.groupMembers) && request.resource.data.groupId == groupId;
        allow update: if isExistingMember(resource.data.groupMembers) && request.resource.data.groupId == resource.data.groupId;
        allow delete: if isExistingMember(resource.data.groupMembers);
      }
    }
  }
}